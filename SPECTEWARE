		local data = trackedWorldObjects[obj]
		if not data then return end
		if data.highlight then data.highlight:Destroy() end
		if data.label then data.label:Destroy() end
		trackedWorldObjects[obj] = nil
	end

	local function getPart(obj)
		if obj:IsA("BasePart") then return obj end
		if obj:IsA("Model") then
			return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
		end
		return nil
	end

	local function registerWorldObj(obj, category, color, displayName)
		if trackedWorldObjects[obj] then return end
		local part = getPart(obj)
		if not part or not worldGui then return end

		local highlight = Instance.new("Highlight")
		highlight.Adornee = obj
		highlight.FillColor = color
		highlight.OutlineColor = Color3.new(0, 0, 0)
		highlight.FillTransparency = 0.5
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Enabled = false
		highlight.Parent = obj

		local billboard = Instance.new("BillboardGui")
		billboard.Adornee = part
		billboard.Size = UDim2.fromOffset(200, 36)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.Enabled = false
		billboard.Parent = worldGui

		local text = Instance.new("TextLabel")
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextSize = 14
		text.TextColor3 = color
		text.TextStrokeColor3 = Color3.new(0, 0, 0)
		text.TextStrokeTransparency = 0
		text.Text = displayName .. "\nDistance: 0 studs"
		text.Parent = billboard

		trackedWorldObjects[obj] = {
			highlight = highlight,
			label = billboard,
			text = text,
			part = part,
			category = category,
			name = displayName
		}
	end

	local function scanWorldFolders()
		local genMonuments = Workspace:FindFirstChild("GeneratedMonuments")
		if genMonuments then
			for _, desc in ipairs(genMonuments:GetDescendants()) do
				local nameLower = desc.Name:lower()
				if nameLower == "locked crate" then
					registerWorldObj(desc, "LockedCrates", Color3.fromRGB(255, 50, 50), "Locked Crate")
				elseif nameLower == "crate" then
					registerWorldObj(desc, "Crates", Color3.fromRGB(255, 165, 0), "Crate")
				elseif nameLower == "scientists" or (desc.Parent and desc.Parent.Name:lower() == "scientists") then
					if desc:IsA("Model") or desc:IsA("BasePart") then
						registerWorldObj(desc, "NPCs", Color3.fromRGB(220, 50, 220), "Scientist")
					end
				end
			end
		end

		local boatSpawns = Workspace:FindFirstChild("BoatSpawns")
		if boatSpawns then
			for _, desc in ipairs(boatSpawns:GetDescendants()) do
				if (desc:IsA("Model") or desc:IsA("BasePart")) and desc.Name:lower() ~= "boatspawns" then
					registerWorldObj(desc, "Boats", Color3.fromRGB(50, 150, 255), "Boat")
				end
			end
		end
	end

	scanWorldFolders()
	task.spawn(function()
		while true do
			task.wait(4)
			scanWorldFolders()
		end
	end)

	Workspace.DescendantRemoving:Connect(function(obj)
		removeWorldESP(obj)
	end)

	RunService.RenderStepped:Connect(function()
		if not worldGui or not worldGui.Parent then return end
		local char = LocalPlayer.Character
		local root = char and char:FindFirstChild("HumanoidRootPart")

		local cratesActive = Toggles.Crates.Value
		local lCratesActive = Toggles.LockedCrates.Value
		local boatsActive = Toggles.Boats.Value
		local npcsActive = Toggles.NPCs.Value

		for obj, data in pairs(trackedWorldObjects) do
			if not obj.Parent then
				removeWorldESP(obj)
			else
				local active = false
				if data.category == "Crates" then active = cratesActive
				elseif data.category == "LockedCrates" then active = lCratesActive
				elseif data.category == "Boats" then active = boatsActive
				elseif data.category == "NPCs" then active = npcsActive end

				if active then
					data.highlight.Enabled = true
					if data.label.Parent ~= worldGui then data.label.Parent = worldGui end
					data.label.Enabled = true
					if root and data.part and data.part:IsDescendantOf(Workspace) then
						local dist = (root.Position - data.part.Position).Magnitude
						data.text.Text = string.format("%s\nDistance: %d studs", data.name, math.floor(dist + 0.5))
					else
						data.text.Text = data.name .. "\nDistance: --"
					end
				else
					data.highlight.Enabled = false
					data.label.Enabled = false
				end
			end
		end
	end)
end)

