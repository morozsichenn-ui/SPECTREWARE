		corner.Parent = fovCircle
	end

	initAimGui()
	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.3)
		initAimGui()
	end)

	RunService.RenderStepped:Connect(function()
		if not fovCircle or not fovCircle.Parent then return end
		local fovVal = Options.AimFOV.Value
		fovCircle.Size = UDim2.fromOffset(fovVal * 2, fovVal * 2)
		fovCircle.Visible = Toggles.DrawFOV.Value

		if Toggles.AimAssist.Value and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
			local cam = Workspace.CurrentCamera
			if not cam then return end

			local myChar = LocalPlayer.Character
			local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
			local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
			if not myChar or not myRoot or not myHum or myHum.Health <= 0 then return end

			local center = cam.ViewportSize / 2
			local closestPlr, closestDist = nil, fovVal

			for _, p in ipairs(Players:GetPlayers()) do
				if p ~= LocalPlayer and p.Character then
					local char = p.Character
					local hum = char:FindFirstChildOfClass("Humanoid")
					local part = char:FindFirstChild(Options.AimPart.Value) or char:FindFirstChild("Head")
					local tRoot = char:FindFirstChild("HumanoidRootPart")

					if hum and hum.Health > 0 and part and tRoot then
						if (tRoot.Position - myRoot.Position).Magnitude <= Options.AimDist.Value then
							local scrPos, vis = cam:WorldToViewportPoint(part.Position)
							if vis and scrPos.Z > 0 then
								local dist = (Vector2.new(scrPos.X, scrPos.Y) - center).Magnitude
								if dist <= closestDist then
									closestDist = dist
									closestPlr = p
								end
							end
						end
					end
				end
			end

			if closestPlr and closestPlr.Character then
				local targetPart = closestPlr.Character:FindFirstChild(Options.AimPart.Value) or closestPlr.Character:FindFirstChild("Head")
				if targetPart then
					local desired = CFrame.lookAt(cam.CFrame.Position, targetPart.Position)
					cam.CFrame = cam.CFrame:Lerp(desired, 0.18)
				end
			end
		end
	end)
end)

