-- Функция для полной очистки старых GUI при смерти/респавне
local function clearOldUIs()
	local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
	if not playerGui then return end
	
	for _, guiName in ipairs({
		"SPECTREWARE_PlayerESP",
		"SPECTREWARE_Tracers",
		"SPECTREWARE_Arrows",
		"SPECTREWARE_OreESPLabels",
		"SPECTREWARE_WorldESP",
		"SPECTREWARE_AimAssistGui",
		"SPECTREWARE_Crosshair"
	}) do
		local oldGui = playerGui:FindFirstChild(guiName)
		if oldGui then
			oldGui:Destroy()
		end
	end
end

