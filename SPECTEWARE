task.spawn(function()
	local originalTrans = {}
	local xRayFolder = nil

	local function updateXRayFolder()
		local pbs = Workspace:FindFirstChild("PlayerBuiltStructures")
		xRayFolder = pbs and pbs:FindFirstChild("Structures")
	end

	updateXRayFolder()
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == "PlayerBuiltStructures" then
			task.wait(0.5)
			updateXRayFolder()
		end
	end)

	local function applyXRay()
		if not xRayFolder then updateXRayFolder() end
		if not xRayFolder then return end
		local trans = Options.XRayTrans.Value / 100
		for _, part in ipairs(xRayFolder:GetDescendants()) do
			if part:IsA("BasePart") then
				if originalTrans[part] == nil then
					originalTrans[part] = part.LocalTransparencyModifier
				end
				part.LocalTransparencyModifier = trans
			end
		end
	end

	local function restoreXRay()
		for part, orig in pairs(originalTrans) do
			if part and part.Parent then
				part.LocalTransparencyModifier = orig
			end
		end
		table.clear(originalTrans)
	end

	Toggles.XRay:OnChanged(function()
		if Toggles.XRay.Value then
			applyXRay()
		else
			restoreXRay()
		end
	end)

	Options.XRayTrans:OnChanged(function()
		if Toggles.XRay.Value then
			applyXRay()
		end
	end)
end)

