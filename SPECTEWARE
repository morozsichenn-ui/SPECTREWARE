-- 1. PLAYER ESP V3
task.spawn(function()
	local BOX_COLOR = Color3.fromRGB(255, 255, 255)
	local HEALTH_BAR_WIDTH = 4
	local espObjects = {}
	local gui = nil

	local function createFrame(parent, color, zIndex)
		local frame = Instance.new("Frame")
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = color
		frame.ZIndex = zIndex or 2
		frame.Parent = parent
		return frame
	end

	local function createESP(player)
		if player == LocalPlayer or not gui then return end
		if espObjects[player] then
			if espObjects[player].Box then espObjects[player].Box:Destroy() end
			if espObjects[player].Label then espObjects[player].Label:Destroy() end
			if espObjects[player].HealthBack then espObjects[player].HealthBack:Destroy() end
		end

		local box = Instance.new("Frame")
		box.BackgroundTransparency = 1
		box.Visible = false
		box.Parent = gui

		local sides = {}
		for i = 1, 4 do sides[i] = createFrame(box, BOX_COLOR, 3) end

		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.new(1, 1, 1)
		label.TextStrokeColor3 = Color3.new(0, 0, 0)
		label.TextStrokeTransparency = 0
		label.Font = Enum.Font.Code
		label.TextSize = 13
		label.Visible = false
		label.Parent = gui

		local healthBack = createFrame(gui, Color3.fromRGB(15, 15, 15), 2)
		healthBack.Visible = false

		local healthFill = createFrame(healthBack, Color3.fromRGB(50, 220, 80), 3)
		healthFill.AnchorPoint = Vector2.new(0, 1)
		healthFill.Position = UDim2.new(0, 0, 1, 0)
		healthFill.Size = UDim2.new(1, 0, 1, 0)

		espObjects[player] = { Box = box, Sides = sides, Label = label, HealthBack = healthBack, HealthFill = healthFill }
	end

	local function initPlayerESP()
		if gui then gui:Destroy() end
		espObjects = {}
		gui = Instance.new("ScreenGui")
		gui.Name = "SPECTREWARE_PlayerESP"
		gui.ResetOnSpawn = false
		gui.IgnoreGuiInset = true
		gui.DisplayOrder = 100
		gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
	end

	initPlayerESP()
	Players.PlayerAdded:Connect(createESP)
	Players.PlayerRemoving:Connect(function(p)
		if espObjects[p] then
			if espObjects[p].Box then espObjects[p].Box:Destroy() end
			if espObjects[p].Label then espObjects[p].Label:Destroy() end
			if espObjects[p].HealthBack then espObjects[p].HealthBack:Destroy() end
			espObjects[p] = nil
		end
	end)

	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.3)
		initPlayerESP()
	end)

	RunService.RenderStepped:Connect(function()
		local active = Toggles.PlayerESP.Value
		for _, objects in pairs(espObjects) do
			if not active then
				if objects.Box then objects.Box.Visible = false end
				if objects.Label then objects.Label.Visible = false end
				if objects.HealthBack then objects.HealthBack.Visible = false end
			end
		end

		if not active then return end

		local camera = Workspace.CurrentCamera
		if not camera then return end

		local myChar = LocalPlayer.Character
		local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

		for player, objects in pairs(espObjects) do
			local char = player.Character
			if not char or not myChar or not objects.Box or not objects.Box.Parent then
				continue
			end

			local root = char:FindFirstChild("HumanoidRootPart")
			local hum = char:FindFirstChildOfClass("Humanoid")
			local head = char:FindFirstChild("Head")

			if not root or not hum or not head or not myRoot or hum.Health <= 0 then
				objects.Box.Visible = false
				objects.Label.Visible = false
				objects.HealthBack.Visible = false
				continue
			end

			local localPoint = camera.CFrame:PointToObjectSpace(root.Position)
			if localPoint.Z > 0 then
				objects.Box.Visible = false
				objects.Label.Visible = false
				objects.HealthBack.Visible = false
				continue
			end

			local topW = head.Position + Vector3.new(0, head.Size.Y * 0.5 - 0.25, 0)
			local botW = root.Position - Vector3.new(0, hum.HipHeight + root.Size.Y * 0.5 - 0.15, 0)
			local top = camera:WorldToViewportPoint(topW)
			local bottom = camera:WorldToViewportPoint(botW)

			local height = math.abs(bottom.Y - top.Y)
			if height < 2 then
				objects.Box.Visible = false
				objects.Label.Visible = false
				objects.HealthBack.Visible = false
				continue
			end

			local width = height * 0.48
			local x = top.X - width * 0.5
			local y = top.Y
			local thick = 1.5

			objects.Box.Position = UDim2.fromOffset(x, y)
			objects.Box.Size = UDim2.fromOffset(width, height)

			objects.Sides[1].Position = UDim2.fromOffset(0, 0); objects.Sides[1].Size = UDim2.new(1, 0, 0, thick)
			objects.Sides[2].Position = UDim2.new(0, 0, 1, -thick); objects.Sides[2].Size = UDim2.new(1, 0, 0, thick)
			objects.Sides[3].Position = UDim2.fromOffset(0, 0); objects.Sides[3].Size = UDim2.new(0, thick, 1, 0)
			objects.Sides[4].Position = UDim2.new(1, -thick, 0, 0); objects.Sides[4].Size = UDim2.new(0, thick, 1, 0)

			local pct = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
			objects.Label.Position = UDim2.fromOffset(x - 50, y - 39)
			objects.Label.Size = UDim2.fromOffset(width + 100, 36)
			objects.Label.Text = string.format("%s\n%d studs", player.DisplayName, math.floor((root.Position - myRoot.Position).Magnitude + 0.5))

			objects.HealthBack.Position = UDim2.fromOffset(x - HEALTH_BAR_WIDTH - 3, y)
			objects.HealthBack.Size = UDim2.fromOffset(HEALTH_BAR_WIDTH, height)
			objects.HealthFill.Size = UDim2.new(1, 0, pct, 0)
			objects.HealthFill.BackgroundColor3 = Color3.new(1 - pct, pct, 0)

			objects.Box.Visible = true
			objects.Label.Visible = true
			objects.HealthBack.Visible = true
		end
	end)
end)

-- 2. TRACERS & ARROWS
task.spawn(function()
	local tGui, aGui
	local tracers = {}
	local arrows = {}

	local function initTracersAndArrows()
		if tGui then tGui:Destroy() end
		if aGui then aGui:Destroy() end
		tracers = {}
		arrows = {}

		tGui = Instance.new("ScreenGui")
		tGui.Name = "SPECTREWARE_Tracers"
		tGui.ResetOnSpawn = false
		tGui.IgnoreGuiInset = true
		tGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		aGui = Instance.new("ScreenGui")
		aGui.Name = "SPECTREWARE_Arrows"
		aGui.ResetOnSpawn = false
		aGui.IgnoreGuiInset = true
		aGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

		local function addPlayerVisuals(p)
			if p == LocalPlayer then return end
			if not tracers[p] then
				local line = Instance.new("Frame")
				line.AnchorPoint = Vector2.new(0.5, 0.5)
				line.BorderSizePixel = 0
				line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
				line.Visible = false
				line.Parent = tGui
				tracers[p] = line
			end
			if not arrows[p] then
				local lbl = Instance.new("TextLabel")
				lbl.Size = UDim2.fromOffset(22, 22)
				lbl.AnchorPoint = Vector2.new(0.5, 0.5)
				lbl.BackgroundTransparency = 1
				lbl.Text = "▲"
				lbl.Font = Enum.Font.GothamBold
				lbl.TextSize = 22
				lbl.TextColor3 = Color3.new(1, 1, 1)
				lbl.TextStrokeTransparency = 0.1
				lbl.Visible = false
				lbl.Parent = aGui
				arrows[p] = { label = lbl, angle = nil }
			end
		end

		for _, p in ipairs(Players:GetPlayers()) do addPlayerVisuals(p) end
	end

	initTracersAndArrows()
	Players.PlayerAdded:Connect(function(p)
		if p ~= LocalPlayer and tGui then
			local line = Instance.new("Frame")
			line.AnchorPoint = Vector2.new(0.5, 0.5)
			line.BorderSizePixel = 0
			line.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			line.Visible = false
			line.Parent = tGui
			tracers[p] = line
		end
		if p ~= LocalPlayer and aGui then
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.fromOffset(22, 22)
			lbl.AnchorPoint = Vector2.new(0.5, 0.5)
			lbl.BackgroundTransparency = 1
			lbl.Text = "▲"
			lbl.Font = Enum.Font.GothamBold
			lbl.TextSize = 22
			lbl.TextColor3 = Color3.new(1, 1, 1)
			lbl.TextStrokeTransparency = 0.1
			lbl.Visible = false
			lbl.Parent = aGui
			arrows[p] = { label = lbl, angle = nil }
		end
	end)

	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.3)
		initTracersAndArrows()
	end)

	RunService.RenderStepped:Connect(function(dt)
		local tracersActive = Toggles.Tracers.Value
		local arrowsActive = Toggles.Arrows.Value

		if not tracersActive then
			for _, line in pairs(tracers) do
				if line then line.Visible = false end
			end
		end

		if not arrowsActive then
			for _, data in pairs(arrows) do
				if data and data.label then data.label.Visible = false end
			end
		end

		if not tracersActive and not arrowsActive then return end

		local cam = Workspace.CurrentCamera
		if not cam then return end
		local vp = cam.ViewportSize
		local center = vp / 2

		for p, line in pairs(tracers) do
			if not tracersActive or not line.Parent then continue end
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not char or not root or not hum or hum.Health <= 0 then
				line.Visible = false
				continue
			end
			local pt, onScreen = cam:WorldToViewportPoint(root.Position)
			if not onScreen or pt.Z <= 0 then
				line.Visible = false
				continue
			end
			local startP = Vector2.new(center.X, vp.Y - 4)
			local endP = Vector2.new(pt.X, pt.Y)
			local diff = endP - startP
			line.Position = UDim2.fromOffset((startP.X + endP.X) / 2, (startP.Y + endP.Y) / 2)
			line.Size = UDim2.fromOffset(diff.Magnitude, 1)
			line.Rotation = math.deg(math.atan2(diff.Y, diff.X))
			line.Visible = true
		end

		for p, data in pairs(arrows) do
			local lbl = data.label
			if not arrowsActive or not lbl.Parent then continue end
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not root or not hum or hum.Health <= 0 then lbl.Visible = false; continue end
			local offset = root.Position - cam.CFrame.Position
			local localDir = cam.CFrame:VectorToObjectSpace(offset.Unit)
			local screenDir = Vector2.new(localDir.X, -localDir.Y)
			if localDir.Z > 0 then screenDir = -screenDir end
			if screenDir.Magnitude < 0.001 then screenDir = Vector2.new(0, -1) else screenDir = screenDir.Unit end
			local targetAngle = math.atan2(screenDir.Y, screenDir.X)
			if not data.angle then data.angle = targetAngle else
				local diff = math.atan2(math.sin(targetAngle - data.angle), math.cos(targetAngle - data.angle))
				data.angle = data.angle + diff * (1 - math.exp(-14 * dt))
			end
			lbl.Position = UDim2.fromOffset(center.X + math.cos(data.angle) * 65, center.Y + math.sin(data.angle) * 65)
			lbl.Rotation = math.deg(data.angle) + 90
			lbl.Visible = true
		end
	end)
end)

-- 3. ORES ESP
task.spawn(function()
	local oreFolder = Workspace:WaitForChild("OreSpawns", 5)
	if not oreFolder then return end

	local COLORS = {
		["sulfur ore"] = Color3.fromRGB(255, 220, 0),
		["sulfur"] = Color3.fromRGB(255, 220, 0),
		["stone"] = Color3.fromRGB(155, 155, 155),
		["metal ore"] = Color3.fromRGB(165, 85, 45),
		["metal"] = Color3.fromRGB(165, 85, 45),
	}

	local oreGui = nil
	local tracked = {}

	local function initOreGui()
		if oreGui then oreGui:Destroy() end
		oreGui = Instance.new("Folder")
		oreGui.Name = "SPECTREWARE_OreESPLabels"
		oreGui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	end
	initOreGui()

	LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.3)
		initOreGui()
	end)

	local function getOreType(obj)
		return COLORS[obj.Name:lower()] and obj.Name or nil
	end

	local function getOreColor(obj)
		return COLORS[obj.Name:lower()]
	end

	local function getPart(obj)
		if obj:IsA("BasePart") then return obj end
		if obj:IsA("Model") then
			return obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart", true)
		end
		return nil
	end

	local function removeOre(obj)
		local data = tracked[obj]
		if not data then return end
		if data.highlight then data.highlight:Destroy() end
		if data.label then data.label:Destroy() end
		tracked[obj] = nil
	end

	local function registerOre(obj)
		if tracked[obj] or not obj:IsDescendantOf(oreFolder) then return end
		if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end

		local oreType = getOreType(obj)
		local part = getPart(obj)
		if not oreType or not part then return end

		local color = getOreColor(obj)

		local highlight = Instance.new("Highlight")
		highlight.Name = "LocalOreHighlight"
		highlight.Adornee = obj
		highlight.FillColor = color
		highlight.OutlineColor = Color3.new(0, 0, 0)
		highlight.FillTransparency = 0.45
		highlight.OutlineTransparency = 0
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.Enabled = false
		highlight.Parent = obj

		local billboard = Instance.new("BillboardGui")
		billboard.Name = "OreDistanceLabel"
		billboard.Adornee = part
		billboard.Size = UDim2.fromOffset(230, 44)
		billboard.StudsOffset = Vector3.new(0, 3, 0)
		billboard.AlwaysOnTop = true
		billboard.MaxDistance = 100000
		billboard.Enabled = false
		billboard.Parent = oreGui

		local text = Instance.new("TextLabel")
		text.Name = "OreText"
		text.Size = UDim2.fromScale(1, 1)
		text.BackgroundTransparency = 1
		text.Font = Enum.Font.GothamBold
		text.TextSize = 15
		text.TextColor3 = color
		text.TextStrokeColor3 = Color3.new(0, 0, 0)
		text.TextStrokeTransparency = 0
		text.Text = oreType .. "\nDistance: calculating..."
		text.Parent = billboard

		tracked[obj] = {
			highlight = highlight,
			label = billboard,
			text = text,
			part = part,
			type = oreType,
		}
	end

	for _, obj in ipairs(oreFolder:GetDescendants()) do
		registerOre(obj)
	end

	oreFolder.DescendantAdded:Connect(function(obj)
		task.defer(function()
			if obj.Parent and obj:IsDescendantOf(oreFolder) then
				registerOre(obj)
			end
		end)
	end)

	oreFolder.DescendantRemoving:Connect(function(obj)
		removeOre(obj)
	end)

	task.spawn(function()
		while true do
			task.wait(0.2)
			if oreGui and oreGui.Parent then
				local active = Toggles.Ores.Value
				if active then
					local character = LocalPlayer.Character
					local root = character and character:FindFirstChild("HumanoidRootPart")

					for obj, data in pairs(tracked) do
						if not obj:IsDescendantOf(oreFolder) then
							removeOre(obj)
						else
							data.highlight.Enabled = true
							if data.label.Parent ~= oreGui then data.label.Parent = oreGui end
							data.label.Enabled = true

							local part = getPart(obj)
							if part then
								data.part = part
								data.label.Adornee = part
							end

							if root and data.part and data.part:IsDescendantOf(Workspace) then
								local distance = (root.Position - data.part.Position).Magnitude
								data.text.Text = string.format("%s\nDistance: %d studs", data.type, math.floor(distance + 0.5))
							else
								data.text.Text = data.type .. "\nDistance: waiting..."
